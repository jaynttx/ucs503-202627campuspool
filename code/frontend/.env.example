# Copy to frontend/.env.local. Never commit real values.
#
# Leave this unset while developing: the app talks to the API on port 8000 of whatever host you opened
# (localhost, 127.0.0.1, or your computer's address on the Wi-Fi, so you can test on a phone).
# Set it when the API lives somewhere else, for example in production:
# NEXT_PUBLIC_API_URL=https://api.example.com

# Road routes on the ride map use the public OSRM demo server by default (fine for trying things out).
# Run your own for real use, or set this to an empty string to show straight-line distances only.
# NEXT_PUBLIC_OSRM_URL=https://router.project-osrm.org

# GIF search in chat (optional). Get a free key at https://developers.giphy.com > Create an App > API.
# Without it, students can still send GIFs from their own device (end to end encrypted, like photos).
# NEXT_PUBLIC_GIPHY_API_KEY=
