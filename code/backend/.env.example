# Copy to backend/.env and fill in. Never commit the real file.

ENVIRONMENT=development                 # use "production" when deployed
DATABASE_URL=postgresql+psycopg://campuspool:change-me@localhost:5432/campuspool
SECRET_KEY=                             # generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false                     # must be true behind HTTPS in production

# Only addresses on this domain can sign up or sign in.
ALLOWED_EMAIL_DOMAIN=thapar.edu

# One-time codes are emailed through SMTP. Leave SMTP_HOST empty in development to print codes in this console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CampusPool <no-reply@example.com>
SMTP_STARTTLS=true

# Key that encrypts chat messages and chat photos before they are stored. REQUIRED in production.
# Generate one: python3 -c "import base64, secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Keep it secret and back it up: without it, stored messages and photos cannot be read again.
# In development, if this is empty, a key is created once in backend/uploads/.dev_data_key.
DATA_ENCRYPTION_KEY=

# Administrators (comma separated). They get an Admin page for reports, removals and suspensions.
ADMIN_EMAILS=

# Optional extra rule for who may join, as a regular expression matched against the whole email.
# Thapar uses one domain for students and staff, so use this if student addresses follow a pattern.
# EMAIL_PATTERN=

# Set true only when a trusted proxy sets X-Forwarded-For (used for per-IP limits).
# TRUST_PROXY=false

# Tables are created automatically in development. In production set false and use Alembic (see README).
# AUTO_CREATE_TABLES=true

# Optional tuning
# MESSAGE_RETENTION_DAYS=90
# MAX_CHAT_IMAGE_BYTES=5242880
# OTP_TTL_MINUTES=10
# OTP_RESEND_SECONDS=30
# OTP_MAX_PER_HOUR=5
# SESSION_DAYS=30
# UPLOAD_DIR=uploads
# RIDE_GRACE_HOURS=12
# ACTIVITY_GRACE_HOURS=2
